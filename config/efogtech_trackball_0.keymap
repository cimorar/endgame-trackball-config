#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/adaptive_feedback.h>
#include <dt-bindings/zmk/bistable_behavior.h>
#include <dt-bindings/zmk/p2sm.h>

#ifndef LAYER_DEFAULT
#define LAYER_DEFAULT      0
#define LAYER_EXTRAS       1
#define LAYER_DEVICE       2
#define LAYER_SCROLL       3
#define LAYER_SNIPE        4
#define LAYER_USER         5
#endif

#define TWIST_MULTIPLIER   1
#define TWIST_DIVISOR      10

#define SCROLL_MULTIPLIER  1
#define SCROLL_DIVISOR     3

#define SNIPE_MULTIPLIER   1
#define SNIPE_DIVISOR      4

/ {
	keymap {
		compatible = "zmk,keymap";

		default_layer {
			display-name = "Default";
			DECLARE_ENCODERS;
			bindings = <
				// buttons
				&ltmkp LAYER_SNIPE ENTER  &ltmkp LAYER_SCROLL ESC
				&mkp MCLK                 &cdch LAYER_SCROLL 0
				&mkp LCLK                 &mkp RCLK
				&ltm LAYER_EXTRAS MB4     &ltm LAYER_DEVICE MB5

				// rotary encoders
				&kp C_VOL_UP              &kp LC(TAB)
				&kp C_VOL_DN              &kp LC(LS(TAB))
			>;
		};

		layer1 {
			display-name = "Extras";
			DECLARE_ENCODERS;
			bindings = <
			    &bst_copy      &bst_paste
				&bst_cut       &bst_undo
			    &bst_undo      &bst_copy
				&trans         &bst_paste

				&kp C_VOL_UP   &kp LC(TAB)
				&kp C_VOL_DN   &kp LC(LS(TAB))
			>;
		};

		layer2 {
			display-name = "Device";
			DECLARE_ENCODERS;
			bindings = <
				&trans             &bt BT_CLR
				&bst_tog ZBS_TOG   &bt BT_NXT
				&af_toggle AF_TOG  &bt BT_PRV
				&studio_unlock     &trans

				&kp C_VOL_UP       &kp LC(TAB)
				&kp C_VOL_DN       &kp LC(LS(TAB))
			>;
		};

		layer3 {
			display-name = "Scroll";
			DECLARE_ENCODERS;
			bindings = <
			    &trans              &trans
			    &trans              &scrlsens P2SM_INC 1
			    &rrl 1              &scrlsens P2SM_DEC 1
			    &sens P2SM_DEC 1    &sens P2SM_INC 1

				&sens P2SM_DEC 1    &scrlsens P2SM_INC 1
				&sens P2SM_INC 1    &scrlsens P2SM_DEC 1
			>;
		};

		layer4 {
			display-name = "Snipe";
			DECLARE_ENCODERS;
			bindings = <
				&trans           &soft_off
				&trans           &trans
				&trans           &trans
				&trans           &trans

				&kp LEFT         &kp RIGHT
				&kp RIGHT        &kp LEFT
			>;
		};

		layer5 {
			display-name = "User";
			DECLARE_ENCODERS;
			bindings = <
				&trans        &trans
				&trans        &trans
				&trans        &trans
				&trans        &trans

				&kp C_VOL_UP  &kp LC(TAB)
				&kp C_VOL_DN  &kp LC(LS(TAB))
		    >;
		};
	};

	behaviors {
		cdch: click-double-click-hold {
			compatible = "zmk,behavior-hold-tap";
			display-name = "Copy/paste/layer (click/double-click/hold)";
			#binding-cells = <2>;
			flavor = "tap-preferred";
			tapping-term-ms = <325>;
			bindings = <&mo>, <&cdc>;
		};

		cdc: click-double-click {
			compatible = "zmk,behavior-tap-dance";
			display-name = "Copy/paste (click/double-click)";
			#binding-cells = <0>;
			tapping-term-ms = <300>;
			bindings = <&kp LC(C)>, <&kp LC(V)>;
		};

		BCK_FWD: tap-dance-1 {
			compatible = "zmk,behavior-tap-dance";
			display-name = "Back/Forward (tap/double-tap)";
			#binding-cells = <0>;
			tapping-term-ms = <300>;
			bindings = <&mkp MB4>, <&mkp MB5>;
		};
	};

	trackball {
		input-processors = <&zip_scroll_scaler TWIST_MULTIPLIER TWIST_DIVISOR>,
						   <&zip_pointer_accel>, <&zip_scroll_accel>,
						   <&zip_rotate_pointer>, <&zip_rotate_scroll>,
		                   <&zip_ble_report_rate_limit>;

		scroll {
			layers = <LAYER_SCROLL>;
			input-processors = <&zip_xy_scaler SCROLL_MULTIPLIER SCROLL_DIVISOR>, <&zip_axis_clamper>,
							   <&zip_xy_to_scroll_mapper>, <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>,
							   <&zip_dragscroll_accel>, <&zip_rotate_scroll>, <&zip_ble_report_rate_limit>;
		};

		snipe {
			layers = <LAYER_SNIPE>;
			input-processors = <&zip_xy_scaler SNIPE_MULTIPLIER SNIPE_DIVISOR>,
							   <&zip_rotate_pointer>, <&zip_rotate_scroll>, <&zip_ble_report_rate_limit>;
		};
	};

	macros {
		rci_rgb_tog: rgb_tog {
			compatible = "zmk,behavior-macro";
			display-name = "Toggle RGB";
			#binding-cells = <0>;
			wait-ms = <20>;
			bindings
			= <&rgb_ug RGB_TOG>
			, <&ext_power EP_TOG>
			;
		};

		rci_alt_tab: alt_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp TAB>
                , <&macro_pause_for_release>
                , <&macro_release &kp LALT>;
        };

		rci_lctrl_tab: lctrl_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp TAB>
                , <&macro_pause_for_release>
                , <&macro_release &kp LCTRL>;
        };		

		rci_rgb_off: rgb_off {
			compatible = "zmk,behavior-macro";
			display-name = "RGB off";
			#binding-cells = <0>;
			wait-ms = <20>;
			bindings
			= <&ext_power EP_OFF>
			, <&rgb_ug RGB_OFF>
			;
		};
	};
};